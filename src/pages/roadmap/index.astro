---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeMap from '../../components/KnowledgeMap.astro';
import { stages } from '../../data/stages';
import { orderCourseLessons } from '../../lib/course';
import { buildKnowledgeMap } from '../../lib/knowledge-map';

const lessons = orderCourseLessons((await getCollection('lessons')).map(({ data }) => data));
const map = buildKnowledgeMap(stages, lessons);
---

<BaseLayout title="Карта знаний — AlgoDS" description="Зависимости между темами курса и состояние каждого урока.">
  <header class="page-intro shell">
    <p class="eyebrow">Зависимости вместо случайного порядка</p>
    <h1>Карта знаний</h1>
    <p>
      Линейный курс задаёт темп, а карта показывает настоящую структуру: какие этапы
      можно изучать параллельно, где ветви сходятся и что открывает следующий шаг.
    </p>
  </header>

  <div class="shell">
    <KnowledgeMap map={map} lessons={lessons} />
  </div>
</BaseLayout>
