---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import BinarySearchLab from '../../components/BinarySearchLab.astro';
import LanguageSwitch from '../../components/LanguageSwitch.astro';
import LessonPractice from '../../components/LessonPractice.astro';
import LessonProgress from '../../components/LessonProgress.astro';
import { patterns } from '../../data/patterns';
import { practiceTasks } from '../../data/practice';
import { stages } from '../../data/stages';
import { getLessonNavigation, orderCourseLessons } from '../../lib/course';
import { selectLessonPracticeTasks } from '../../lib/practice';
import { buildReferenceEntries } from '../../lib/reference';

export async function getStaticPaths() {
  const entries = await getCollection('lessons');
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'lessons'>;
}

const { entry } = Astro.props;
const orderedLessons = orderCourseLessons((await getCollection('lessons')).map(({ data }) => data));
const { previous, next } = getLessonNavigation(orderedLessons, entry.data.id);
const lessonById = new Map(orderedLessons.map((lesson) => [lesson.id, lesson]));
const stage = stages.find(({ id }) => id === entry.data.stage);
const relatedReferenceEntries = buildReferenceEntries(orderedLessons)
  .filter((reference) => reference.patternId && entry.data.patterns.includes(reference.patternId))
  .slice(0, 2);
const lessonTopics = patterns
  .filter(({ id }) => entry.data.patterns.includes(id))
  .map(({ title }) => title);
const mappedProblems = selectLessonPracticeTasks(practiceTasks, {
  lessonId: entry.data.id,
  lessonStage: entry.data.stage,
  lessonTopics,
  orderedLessons,
});
const { Content } = await render(entry);
const title = `${entry.data.title} — AlgoDS`;
---

<BaseLayout title={title} description={entry.data.summary}>
  <div class="lesson-shell shell">
    <article class="lesson-article">
      <header class="lesson-title">
        <a class="back-link lesson-title__back" href={`/course/#stage-${entry.data.stage}`}>К этапу {entry.data.stage}</a>
        <p class="eyebrow">Этап {entry.data.stage} · урок {entry.data.order}</p>
        <h1>{entry.data.title}</h1>
        <p>{entry.data.summary}</p>
      </header>
      <div class="lesson-tools">
        <LanguageSwitch />
        <button class="text-button" type="button" data-bookmark-id={`lesson:${entry.data.id}`} aria-pressed="false">
          Добавить в закладки
        </button>
      </div>
      <div class="lesson-outcomes">
        <p>После урока вы сможете</p>
        <ul>{entry.data.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
      </div>
      <div class="lesson-body">
        <Content />
      </div>

      {(entry.data.slug === 'binary-search-invariant' || entry.data.slug === 'binary-search-boundaries') && (
        <BinarySearchLab />
      )}

      <LessonProgress lessonId={entry.data.id} prerequisites={entry.data.prerequisites} />
      <LessonPractice problems={mappedProblems} />

      <nav class="lesson-navigation" aria-label="Навигация по урокам">
        {previous ? (
          <a href={`/course/${previous.slug}/`} rel="prev">
            <small>Предыдущий урок</small><strong>{previous.title}</strong>
          </a>
        ) : <span></span>}
        {next ? (
          <a href={`/course/${next.slug}/`} rel="next">
            <small>Следующий урок</small><strong>{next.title}</strong>
          </a>
        ) : (
          <a href="/practice/"><small>Маршрут завершён</small><strong>Перейти к практике</strong></a>
        )}
      </nav>
    </article>

    <aside class="lesson-sidebar" aria-label="О текущем уроке">
      <a class="back-link lesson-sidebar__back" href={`/course/#stage-${entry.data.stage}`}>К этапу {entry.data.stage}</a>
      <p class="lesson-sidebar__stage">{stage?.title}</p>
      <dl>
        <div><dt>Урок</dt><dd>{entry.data.id}</dd></div>
        <div><dt>Практика</dt><dd>{entry.data.practice.miniChecks} проверки · {entry.data.practice.guidedExercises} разбор</dd></div>
      </dl>
      <div class="lesson-context-links">
        <h2>Связи</h2>
        <ul>
          <li><a href="/roadmap/">На карте знаний</a></li>
          {relatedReferenceEntries.length > 0 ? relatedReferenceEntries.map((reference) => (
            <li><a href={reference.href}>{reference.title} — кратко</a></li>
          )) : (
            <li><a href="/reference/">Открыть справочник</a></li>
          )}
        </ul>
      </div>
      {entry.data.prerequisites.length > 0 && (
        <div class="lesson-prerequisites">
          <h2>Перед этим</h2>
          <ul>
            {entry.data.prerequisites.map((id) => {
              const prerequisite = lessonById.get(id);
              return prerequisite && <li><a href={`/course/${prerequisite.slug}/`}>{prerequisite.title}</a></li>;
            })}
          </ul>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
