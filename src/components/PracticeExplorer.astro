---
import { getCollection } from 'astro:content';

import type { LeetCode75Group } from '../data/leetcode75';
import type { SupplementaryProblem } from '../data/supplementary-practice';
import { orderPracticeProblems } from '../lib/course';
import { buildPracticeExplorerProblems } from '../lib/practice-explorer';
import ProblemStatus from './ProblemStatus.astro';

interface Props {
  groups: LeetCode75Group[];
  additionalProblems?: SupplementaryProblem[];
  grouped?: boolean;
  showVerification?: boolean;
}

const { groups, additionalProblems = [], grouped = false, showVerification = false } = Astro.props;
const problems = buildPracticeExplorerProblems(groups, additionalProblems);
const displayProblems = grouped ? problems : orderPracticeProblems(problems);
const lessonById = new Map((await getCollection('lessons')).map(({ data }) => [data.id, data]));
const stageOptions = [...new Set(problems.map(({ recommendedStage }) => recommendedStage))].sort((a, b) => a - b);
const modeLabels = {
  guided: 'С разбором',
  transfer: 'Перенос паттерна',
  independent: 'Самостоятельно',
} as const;
const difficultyLabel = { Easy: 'Легко', Medium: 'Средне', Hard: 'Сложно' } as const;
const providers = [...new Set(problems.map(({ providerId, provider }) => JSON.stringify([providerId, provider])))]
  .map((entry) => JSON.parse(entry) as [string, string]);
const displayGroups = grouped
  ? groups.map(({ name, order }) => ({
      name,
      order,
      problems: displayProblems.filter(({ officialGroup }) => officialGroup === name),
    }))
  : [{ name: 'Практика', order: 1, problems: displayProblems }];
---

<div class="practice-explorer" data-practice-explorer>
  <form class="practice-filters" data-practice-filters aria-label="Фильтры задач">
    <label>
      <span>Поиск</span>
      <input type="search" placeholder="Название, ID или паттерн" data-filter-query />
    </label>
    <label>
      <span>Этап</span>
      <select data-filter-stage>
        <option value="all">Все этапы</option>
        {stageOptions.map((stage) => <option value={stage}>Этап {stage}</option>)}
      </select>
    </label>
    {providers.length > 1 && (
      <label>
        <span>Платформа</span>
        <select data-filter-provider>
          <option value="all">Все платформы</option>
          {providers.map(([id, name]) => <option value={id}>{name}</option>)}
        </select>
      </label>
    )}
    <label>
      <span>Режим</span>
      <select data-filter-mode>
        <option value="all">Все режимы</option>
        <option value="guided">С разбором</option>
        <option value="transfer">Перенос паттерна</option>
        <option value="independent">Самостоятельно</option>
      </select>
    </label>
    <label>
      <span>Статус</span>
      <select data-filter-status>
        <option value="all">Все статусы</option>
        <option value="not-started">Не начаты</option>
        <option value="solved-independent">Самостоятельно</option>
        <option value="solved-with-help">С подсказкой</option>
        <option value="revisit">Повторить</option>
      </select>
    </label>
  </form>

  <p class="filter-result"><strong data-filter-count>{problems.length}</strong> задач показано</p>
  {showVerification && (
    <p class="verification-note">Состав и порядок сверены с официальным LeetCode 20 августа 2026 года.</p>
  )}

  {displayGroups.map((group) => (
    <section
      class="practice-group"
      data-practice-group
      aria-labelledby={grouped ? `practice-group-${group.order}` : undefined}
      aria-label={grouped ? undefined : 'Список задач'}
    >
      {grouped && <h2 id={`practice-group-${group.order}`}>{group.name}</h2>}
      <div class="table-scroll" tabindex="0" aria-label={`Таблица задач: ${group.name}`}>
        <table class="practice-table">
          <thead>
            <tr><th>Задача</th><th>Режим</th><th>Паттерн</th><th>Этап</th><th>Статус</th></tr>
          </thead>
          <tbody>
            {group.problems.map((problem) => (
              <tr
                data-practice-row
                data-problem-id={problem.progressId}
                data-provider={problem.providerId}
                data-stage={problem.recommendedStage}
                data-mode={problem.practiceMode}
                data-problem-prerequisites={problem.prerequisiteLessonIds.join(',')}
                data-problem-readiness="blocked"
                data-search-text={problem.searchText}
              >
                <td>
                  <a href={problem.url} target="_blank" rel="noopener noreferrer">
                    <span class="problem-id">{problem.id}</span> {problem.title}
                  </a>
                  <small>{problem.provider} · проверено {problem.verifiedAt} · {difficultyLabel[problem.difficulty]}</small>
                  <small>{problem.learningNoteRu}</small>
                  <small class="problem-prerequisites">
                    После: {problem.prerequisiteLessonIds.map((id, index) => {
                      const lesson = lessonById.get(id);
                      return lesson && <><a href={`/course/${lesson.slug}/`}>{lesson.title}</a>{index < problem.prerequisiteLessonIds.length - 1 ? ', ' : ''}</>;
                    })}
                  </small>
                </td>
                <td>{modeLabels[problem.practiceMode]}</td>
                <td>
                  {problem.practiceMode === 'independent' ? (
                    <details class="pattern-reveal"><summary>Показать</summary><span>{problem.primaryPattern}</span></details>
                  ) : problem.primaryPattern}
                </td>
                <td>
                  <a href={`/course/#stage-${problem.recommendedStage}`}>Этап {problem.recommendedStage}</a>
                  <small data-problem-readiness-label>Зависимости не завершены</small>
                </td>
                <td><ProblemStatus problemId={problem.progressId} title={problem.title} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</div>
