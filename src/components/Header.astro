---
import ThemeToggle from './ThemeToggle.astro';
import GlobalSearch from './GlobalSearch.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const navigation = [
  { href: '/course/', label: 'Курс' },
  { href: '/roadmap/', label: 'Карта знаний' },
  { href: '/practice/', label: 'Практика' },
  { href: '/leetcode-75/', label: 'LeetCode 75' },
  { href: '/reference/', label: 'Справочник' },
] as const;

const isActive = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="AlgoDS — на главную">
      <span>AlgoDS</span>
    </a>

    <nav class="desktop-nav" aria-label="Основная навигация">
      <ul>
        {navigation.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <GlobalSearch />
      <ThemeToggle />
      <details class="mobile-menu">
        <summary>
          <span>Меню</span>
        </summary>
        <nav aria-label="Мобильная навигация">
          <ul>
            {navigation.map(({ href, label }) => (
              <li>
                <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
    menu.addEventListener('toggle', () => {
      if (!menu.open) return;
      document.querySelectorAll<HTMLDetailsElement>('[data-global-search][open]').forEach((search) => {
        search.open = false;
      });
    });
  });
</script>
