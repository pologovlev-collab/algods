---
import { createLowerBoundTrace } from '../lib/binary-search-trace';

const trace = createLowerBoundTrace([1, 3, 3, 6, 8, 11, 14, 19], 8);
---

<section class="binary-lab" data-binary-lab data-trace={JSON.stringify(trace)} aria-labelledby="binary-lab-title">
  <div class="binary-lab__heading">
    <p class="eyebrow">Интерактивная трассировка</p>
    <h2 id="binary-lab-title">Граница первого элемента ≥ 8</h2>
    <p>Инвариант: ответ всё время остаётся внутри полуинтервала <code>[lo, hi)</code>.</p>
  </div>
  <ol class="binary-array" aria-label="Отсортированный массив">
    {trace.values.map((value, index) => (
      <li data-binary-index={index}>
        <span>{value}</span>
        <small>{index}</small>
      </li>
    ))}
  </ol>
  <p class="binary-lab__explanation" data-binary-explanation aria-live="polite">
    Начальное состояние: граница находится где-то в [0, 8).
  </p>
  <div class="binary-lab__controls">
    <button class="button button--secondary" type="button" data-binary-previous disabled>Назад</button>
    <button class="button button--primary" type="button" data-binary-next>Следующий шаг</button>
    <button class="text-button" type="button" data-binary-reset>Сбросить</button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-binary-lab]').forEach((lab) => {
    const raw = lab.dataset.trace;
    if (!raw) return;
    const trace = JSON.parse(raw) as {
      target: number;
      resultIndex: number;
      found: boolean;
      values: number[];
      steps: Array<{
        lo: number;
        hi: number;
        mid: number;
        midValue: number;
        decision: 'move-left' | 'move-right';
      }>;
    };
    let position = -1;
    const explanation = lab.querySelector<HTMLElement>('[data-binary-explanation]');
    const previous = lab.querySelector<HTMLButtonElement>('[data-binary-previous]');
    const next = lab.querySelector<HTMLButtonElement>('[data-binary-next]');
    const cells = [...lab.querySelectorAll<HTMLElement>('[data-binary-index]')];

    const render = () => {
      const step = trace.steps[position];
      cells.forEach((cell) => {
        const index = Number(cell.dataset.binaryIndex);
        cell.dataset.binaryState = !step
          ? 'candidate'
          : index === step.mid
            ? 'mid'
            : index >= step.lo && index < step.hi
              ? 'candidate'
              : 'discarded';
      });
      if (position < 0 && explanation) {
        explanation.textContent = `Начальное состояние: граница находится где-то в [0, ${trace.values.length}).`;
      } else if (step && explanation) {
        explanation.textContent =
          step.decision === 'move-left'
            ? `a[${step.mid}] = ${step.midValue} ≥ ${trace.target}. Индекс ${step.mid} подходит, но ищем более левую границу: hi = ${step.mid}.`
            : `a[${step.mid}] = ${step.midValue} < ${trace.target}. Всё слева вместе с mid не подходит: lo = ${step.mid + 1}.`;
      } else if (explanation) {
        explanation.textContent = trace.found
          ? `Границы встретились на индексе ${trace.resultIndex}: это первое вхождение ${trace.target}.`
          : `Границы встретились на индексе вставки ${trace.resultIndex}; значения ${trace.target} в массиве нет.`;
      }
      if (previous) previous.disabled = position < 0;
      if (next) {
        next.disabled = position >= trace.steps.length;
        next.textContent = position + 1 >= trace.steps.length ? 'Показать ответ' : 'Следующий шаг';
      }
    };

    previous?.addEventListener('click', () => {
      position = Math.max(-1, position - 1);
      render();
    });
    next?.addEventListener('click', () => {
      position = Math.min(trace.steps.length, position + 1);
      render();
    });
    lab.querySelector('[data-binary-reset]')?.addEventListener('click', () => {
      position = -1;
      render();
    });
    render();
  });
</script>
