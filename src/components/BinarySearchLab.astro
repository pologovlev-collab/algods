---
import {
  createExactSearchTrace,
  createLowerBoundTrace,
  getExactSearchTraceFrames,
  getLowerBoundTraceFrames,
} from '../lib/binary-search-trace';

interface Props {
  mode: 'exact' | 'lower-bound';
}

const { mode } = Astro.props;
const exactSearch = mode === 'exact';
const tracePayload = exactSearch
  ? (() => {
      const trace = createExactSearchTrace([1, 3, 3, 6, 8, 11, 14, 19], 11);
      return { mode, ...trace, frames: getExactSearchTraceFrames(trace) };
    })()
  : (() => {
      const trace = createLowerBoundTrace([1, 3, 3, 6, 8, 11, 14, 19], 8);
      return { mode, ...trace, frames: getLowerBoundTraceFrames(trace) };
    })();
const title = exactSearch ? 'Точный поиск значения 11' : 'Граница первого элемента ≥ 8';
const invariant = exactSearch
  ? 'Инвариант: если значение есть, оно остаётся в закрытом диапазоне [lo, hi].'
  : 'Инвариант: ответ всё время остаётся внутри полуинтервала [lo, hi).';
---

<section
  class="binary-lab"
  data-binary-lab
  data-binary-mode={mode}
  data-trace={JSON.stringify(tracePayload)}
  aria-labelledby="binary-lab-title"
>
  <div class="binary-lab__heading">
    <p class="eyebrow">Интерактивная трассировка</p>
    <h2 id="binary-lab-title">{title}</h2>
    <p>{invariant}</p>
  </div>
  <ol class="binary-array" aria-label={`Отсортированный массив для задачи «${title}»`}>
    {tracePayload.values.map((value, index) => (
      <li data-binary-index={index}>
        <span>{value}</span>
        <small>{index}</small>
      </li>
    ))}
  </ol>
  <p class="binary-lab__explanation" data-binary-explanation aria-live="polite">
    {exactSearch
      ? 'Начальное состояние: значение 11 может находиться в закрытом диапазоне [0, 7].'
      : 'Начальное состояние: граница находится где-то в [0, 8).'}
  </p>
  <div class="binary-lab__controls">
    <button class="button button--secondary" type="button" data-binary-previous disabled>Назад</button>
    <button class="button button--primary" type="button" data-binary-next>Следующий шаг</button>
    <button class="text-button" type="button" data-binary-reset>Сбросить</button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-binary-lab]').forEach((lab) => {
    const raw = lab.dataset.trace;
    if (!raw) return;
    const trace = JSON.parse(raw) as {
      mode: 'exact' | 'lower-bound';
      target: number;
      resultIndex: number;
      found: boolean;
      values: number[];
      steps: Array<{
        lo: number;
        hi: number;
        mid: number;
        midValue: number;
        decision: 'move-left' | 'move-right' | 'found';
      }>;
      frames: Array<
        | {
            kind: 'decision';
            lo: number;
            hi: number;
            mid: number;
            midValue: number;
            decision: 'move-left' | 'move-right' | 'found';
            cellStates: Array<'candidate' | 'mid' | 'discarded' | 'result'>;
          }
        | {
            kind: 'result';
            resultIndex: number;
            found: boolean;
            cellStates: Array<'candidate' | 'mid' | 'discarded' | 'result'>;
          }
      >;
    };
    let position = -1;
    const explanation = lab.querySelector<HTMLElement>('[data-binary-explanation]');
    const previous = lab.querySelector<HTMLButtonElement>('[data-binary-previous]');
    const next = lab.querySelector<HTMLButtonElement>('[data-binary-next]');
    const cells = [...lab.querySelectorAll<HTMLElement>('[data-binary-index]')];

    const render = () => {
      const frame = position < 0 ? undefined : trace.frames[position];
      cells.forEach((cell) => {
        const index = Number(cell.dataset.binaryIndex);
        cell.dataset.binaryState = frame?.cellStates[index] ?? 'candidate';
      });
      if (position < 0 && explanation) {
        explanation.textContent = trace.mode === 'exact'
          ? `Начальное состояние: значение ${trace.target} может находиться в закрытом диапазоне [0, ${trace.values.length - 1}].`
          : `Начальное состояние: граница находится где-то в [0, ${trace.values.length}).`;
      } else if (frame?.kind === 'decision' && explanation) {
        if (trace.mode === 'exact') {
          explanation.textContent = frame.decision === 'found'
            ? `a[${frame.mid}] = ${trace.target}. Точное значение найдено на индексе ${frame.mid}.`
            : frame.decision === 'move-left'
              ? `a[${frame.mid}] = ${frame.midValue} > ${trace.target}. Справа ответ невозможен: hi = ${frame.mid - 1}.`
              : `a[${frame.mid}] = ${frame.midValue} < ${trace.target}. Слева ответ невозможен: lo = ${frame.mid + 1}.`;
        } else {
          explanation.textContent = frame.decision === 'move-left'
            ? `a[${frame.mid}] = ${frame.midValue} ≥ ${trace.target}. Индекс ${frame.mid} подходит, но ищем более левую границу: hi = ${frame.mid}.`
            : `a[${frame.mid}] = ${frame.midValue} < ${trace.target}. Всё слева вместе с mid не подходит: lo = ${frame.mid + 1}.`;
        }
      } else if (frame?.kind === 'result' && explanation) {
        explanation.textContent = trace.mode === 'exact'
          ? trace.found
            ? `Ответ: индекс ${trace.resultIndex}. Подсвечено найденное точное значение ${trace.target}.`
            : `Кандидатный диапазон опустел: значения ${trace.target} в массиве нет, ответ −1.`
          : trace.found
            ? `Границы встретились на индексе ${trace.resultIndex}: это первое вхождение ${trace.target}.`
            : `Границы встретились на индексе вставки ${trace.resultIndex}; значения ${trace.target} в массиве нет.`;
      }
      if (previous) previous.disabled = position < 0;
      if (next) {
        next.disabled = position >= trace.steps.length;
        next.textContent = position + 1 >= trace.steps.length ? 'Показать ответ' : 'Следующий шаг';
      }
    };

    previous?.addEventListener('click', () => {
      position = Math.max(-1, position - 1);
      render();
    });
    next?.addEventListener('click', () => {
      position = Math.min(trace.frames.length - 1, position + 1);
      render();
    });
    lab.querySelector('[data-binary-reset]')?.addEventListener('click', () => {
      position = -1;
      render();
    });
    render();
  });
</script>
