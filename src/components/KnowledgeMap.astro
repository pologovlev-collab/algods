---
import type {
  KnowledgeMapLesson,
  KnowledgeMapModel,
} from '../lib/knowledge-map';
import KnowledgeMapLessonList from './KnowledgeMapLessonList.astro';
import KnowledgeMapRelations from './KnowledgeMapRelations.astro';

interface Props {
  map: KnowledgeMapModel;
  lessons: KnowledgeMapLesson[];
}

const { map, lessons } = Astro.props;
const stageById = new Map(map.stages.map((stage) => [stage.id, stage]));
const initialStageId = map.stages[0]?.id ?? 0;
const payload = JSON.stringify({ map, lessons }).replaceAll('<', '\\u003c');
const stageNumber = (id: number) => String(id).padStart(2, '0');
const stageLaneById: Record<number, number> = {
  0: 3,
  1: 3,
  2: 3,
  3: 3,
  4: 2,
  5: 4,
  6: 2,
  7: 3,
  8: 3,
  9: 1,
  10: 3,
  11: 2,
  12: 4,
  13: 2,
  14: 5,
  15: 4,
  16: 3,
  17: 1,
  18: 5,
  19: 3,
  20: 3,
};
const lessonCount = (count: number) => {
  const finalDigit = count % 10;
  const finalTwoDigits = count % 100;
  const word = finalDigit === 1 && finalTwoDigits !== 11
    ? 'урок'
    : finalDigit >= 2 && finalDigit <= 4 && (finalTwoDigits < 12 || finalTwoDigits > 14)
      ? 'урока'
      : 'уроков';
  return `${count} ${word}`;
};
---

<section class="knowledge-map" data-knowledge-map aria-labelledby="knowledge-map-title">
  <div class="knowledge-map__guide">
    <div>
      <p class="eyebrow">Навигация по зависимостям</p>
      <h2 id="knowledge-map-title">21 этап, собранный из реальных связей уроков</h2>
      <p>
        Слева направо растёт глубина зависимостей. На обзоре показаны ключевые переходы,
        а точные прямые зависимости остаются в описании выбранного этапа.
      </p>
    </div>
    <ul class="knowledge-map-legend" aria-label="Состояния карты">
      <li data-state="blocked">Нужны зависимости</li>
      <li data-state="ready">Можно начать</li>
      <li data-state="in-progress">В процессе</li>
      <li data-state="completed">Завершён</li>
    </ul>
  </div>

  <div class="knowledge-map-desktop">
    <div class="knowledge-map-scroll" tabindex="0" aria-label="Обзор ключевых переходов между этапами; прокручивается по горизонтали">
      <div class="knowledge-map-canvas" style={`--map-layer-count: ${map.layers.length}`}>
        <svg class="knowledge-map-edges" aria-hidden="true">
          {map.overviewEdges.map((edge) => (
            <path
              data-map-edge
              data-map-edge-key={`${edge.fromStageId}:${edge.toStageId}`}
              data-from-stage={edge.fromStageId}
              data-to-stage={edge.toStageId}
              data-map-edge-focus="dimmed"
            ></path>
          ))}
        </svg>
        {map.layers.map((stageIds, layer) => (
          <section class="knowledge-map-layer" aria-labelledby={`map-layer-${layer}`}>
            <h3 id={`map-layer-${layer}`}>Уровень {layer}</h3>
            <ol>
              {stageIds.map((id) => {
                const stage = stageById.get(id);
                const focus = map.focusByStageId[id];
                return stage && (
                  <li style={`--map-stage-lane: ${stageLaneById[id] ?? 3}`}>
                    <button
                      class="knowledge-map-stage"
                      type="button"
                      id={`map-stage-${stage.id}`}
                      data-map-stage-id={stage.id}
                      data-map-stage-layer={stage.layer}
                      data-map-predecessor-stage-ids={focus?.predecessorStageIds.join(',')}
                      data-map-unlock-stage-ids={focus?.unlockStageIds.join(',')}
                      data-map-focus-edge-keys={focus?.edgeKeys.join(',')}
                      data-map-stage-focus="dimmed"
                      data-map-stage-state="blocked"
                      data-map-stage-next="false"
                      aria-controls={`map-stage-detail-${stage.id}`}
                      aria-pressed={stage.id === initialStageId ? 'true' : 'false'}
                    >
                      <span class="knowledge-map-stage__meta">
                        <span>Этап {stageNumber(stage.id)}</span>
                        <span>{lessonCount(stage.lessonIds.length)}</span>
                      </span>
                      <strong>{stage.title}</strong>
                      <span class="knowledge-map-stage__status">
                        <span data-map-stage-state-label>Нужны зависимости</span>
                        <span data-map-next-label>Следующий</span>
                      </span>
                      <span class="knowledge-map-stage__dependencies">
                        {stage.prerequisiteStageIds.length > 0
                          ? `После ${stage.prerequisiteStageIds.map((stageId) => stageNumber(stageId)).join(', ')}`
                          : 'Начало маршрута'}
                      </span>
                    </button>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </div>

    <aside class="knowledge-map-detail" aria-label="Выбранный этап" aria-live="polite">
      {map.stages.map((stage) => (
        <section
          id={`map-stage-detail-${stage.id}`}
          data-map-stage-panel={stage.id}
          data-map-stage-id={stage.id}
          data-map-stage-state="blocked"
          hidden={stage.id !== initialStageId}
        >
          <p class="eyebrow">Этап {stageNumber(stage.id)} · уровень {stage.layer}</p>
          <h2>{stage.title}</h2>
          <p>{stage.description}</p>
          <p class="knowledge-map-detail__status">
            <span data-map-stage-state-label>Нужны зависимости</span>
            <span data-map-next-label>Следующий этап</span>
          </p>
          <KnowledgeMapRelations stage={stage} />
          <a class="text-link" href={`/course/#stage-${stage.id}`}>Открыть этап в курсе <span aria-hidden="true">→</span></a>
          <h3>Уроки этапа</h3>
          <KnowledgeMapLessonList lessonIds={stage.lessonIds} lessons={lessons} />
        </section>
      ))}
    </aside>
  </div>

  <ol class="knowledge-map-mobile" aria-label="Этапы курса и их зависимости">
    {map.stages.map((stage) => (
      <li>
        <details
          data-map-stage-id={stage.id}
          data-map-stage-state="blocked"
          data-map-stage-next="false"
          open={stage.id === initialStageId}
        >
          <summary>
            <span><small>Этап {stageNumber(stage.id)}</small><strong>{stage.title}</strong></span>
            <span>
              <span data-map-stage-state-label>Нужны зависимости</span>
              <span data-map-next-label>Следующий</span>
            </span>
          </summary>
          <div class="knowledge-map-mobile__body">
            <p>{stage.description}</p>
            <KnowledgeMapRelations stage={stage} />
            <a class="text-link" href={`/course/#stage-${stage.id}`}>Открыть этап в курсе <span aria-hidden="true">→</span></a>
            <KnowledgeMapLessonList lessonIds={stage.lessonIds} lessons={lessons} />
          </div>
        </details>
      </li>
    ))}
  </ol>

  <script is:inline type="application/json" data-knowledge-map-data set:html={payload}></script>
</section>

<script>
  import '../scripts/knowledge-map';
</script>
