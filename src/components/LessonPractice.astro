---
import {
  PRACTICE_MODE_LABELS,
  PRACTICE_PROVIDER_LABELS,
  PRACTICE_TIER_LABELS,
} from '../data/practice';
import type { PracticeTask } from '../lib/practice';
import ProblemStatus from './ProblemStatus.astro';

interface Props {
  problems: PracticeTask[];
}

const { problems } = Astro.props;
---

{problems.length > 0 && (
  <section class="lesson-practice" aria-labelledby="lesson-practice-title">
    <header>
      <p class="eyebrow">Закрепление</p>
      <h2 id="lesson-practice-title">Попробовать самостоятельно</h2>
      <p>Небольшой маршрут от разбора к самостоятельному решению. Статусы синхронизируются с общей практикой.</p>
    </header>
    <ol>
      {problems.map((problem) => (
        <li data-problem-prerequisites={problem.prerequisiteLessonIds.join(',')} data-problem-readiness="blocked">
          <div>
            <p class="lesson-practice__meta">
              <span>{PRACTICE_MODE_LABELS[problem.mode]}</span>
              <span>{PRACTICE_PROVIDER_LABELS[problem.provider]} · внешняя задача</span>
              <span>{problem.nativeLevel?.label ?? 'Без официального уровня'}</span>
              <span>{PRACTICE_TIER_LABELS[problem.tier]}</span>
            </p>
            <h3><a href={problem.url} target="_blank" rel="noopener noreferrer">{problem.title}</a></h3>
            <p>{problem.noteRu}</p>
            <small data-problem-readiness-label>Сначала завершите уроки-зависимости</small>
          </div>
          <ProblemStatus problemId={problem.id} title={problem.title} />
        </li>
      ))}
    </ol>
    <a class="text-link" href="/practice/">Все задачи по теме <span aria-hidden="true">→</span></a>
  </section>
)}
