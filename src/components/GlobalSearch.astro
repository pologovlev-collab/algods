<details class='global-search' data-global-search>
  <summary>Поиск</summary>
  <div class='global-search__panel'>
    <label for='global-search-input'>Найти тему, урок или задачу</label>
    <input
      id='global-search-input'
      type='search'
      placeholder='Например, binary search или монотонный стек'
      autocomplete='off'
      aria-controls='global-search-results'
      aria-describedby='global-search-status'
      data-global-search-input
    />
    <p id='global-search-status' class='global-search__status' aria-live='polite' data-global-search-status>
      Ищите по-русски или по-английски.
    </p>
    <ul id='global-search-results' data-global-search-results></ul>
  </div>
</details>

<script>
  import { rankSearchEntries, type SearchEntry, type SearchEntryType } from '../lib/search';

  const typeLabels: Record<SearchEntryType, string> = {
    section: 'Раздел',
    stage: 'Этап',
    lesson: 'Урок',
    reference: 'Справочник',
    practice: 'Задача',
  };

  const isSearchEntry = (value: unknown): value is SearchEntry => {
    if (!value || typeof value !== 'object') return false;
    const candidate = value as Partial<SearchEntry>;
    return typeof candidate.id === 'string'
      && typeof candidate.type === 'string'
      && candidate.type in typeLabels
      && typeof candidate.href === 'string'
      && typeof candidate.title === 'string'
      && Array.isArray(candidate.aliases)
      && candidate.aliases.every((item) => typeof item === 'string')
      && Array.isArray(candidate.topics)
      && candidate.topics.every((item) => typeof item === 'string')
      && typeof candidate.context === 'string'
      && typeof candidate.sourceOrder === 'number';
  };

  document.querySelectorAll<HTMLDetailsElement>('[data-global-search]').forEach((search) => {
    const input = search.querySelector<HTMLInputElement>('[data-global-search-input]');
    const status = search.querySelector<HTMLElement>('[data-global-search-status]');
    const results = search.querySelector<HTMLUListElement>('[data-global-search-results]');
    let indexed: SearchEntry[] | undefined;
    let indexRequest: Promise<void> | undefined;

    const visibleLinks = () => [
      ...(results?.querySelectorAll<HTMLAnchorElement>('a') ?? []),
    ];

    const moveResultFocus = (current: HTMLAnchorElement | null, delta: number) => {
      const links = visibleLinks();
      if (links.length === 0) return;
      const currentIndex = current ? links.indexOf(current) : (delta > 0 ? -1 : 0);
      links[(currentIndex + delta + links.length) % links.length]?.focus();
    };

    const createResult = (entry: SearchEntry): HTMLLIElement => {
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = entry.href;

      const heading = document.createElement('span');
      heading.className = 'global-search__result-heading';
      const title = document.createElement('strong');
      title.textContent = entry.title;
      const type = document.createElement('small');
      type.textContent = typeLabels[entry.type];
      heading.append(title, type);

      const context = document.createElement('span');
      context.className = 'global-search__result-context';
      context.textContent = entry.context;
      link.append(heading, context);
      link.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        event.preventDefault();
        moveResultFocus(link, event.key === 'ArrowDown' ? 1 : -1);
      });
      item.append(link);
      return item;
    };

    const render = () => {
      if (!indexed) return;
      const query = input?.value ?? '';
      const allMatches = rankSearchEntries(indexed, query, indexed.length);
      const matches = allMatches.slice(0, 10);
      results?.replaceChildren(...matches.map(createResult));

      if (!status) return;
      status.textContent = query.trim().length === 0
        ? 'Ищите по-русски или по-английски.'
        : allMatches.length === 0
          ? 'Ничего не найдено. Попробуйте название паттерна или задачи.'
          : allMatches.length > matches.length
            ? `Показано ${matches.length} из ${allMatches.length}`
            : `Найдено: ${matches.length}`;
    };

    const loadIndex = (): Promise<void> => {
      if (indexed) return Promise.resolve();
      if (indexRequest) return indexRequest;
      if (status) status.textContent = 'Загружаем поисковый индекс…';
      indexRequest = (async () => {
        try {
          const response = await fetch('/search-index.json', { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error(`Search index returned ${response.status}.`);
          const parsed: unknown = await response.json();
          indexed = Array.isArray(parsed) ? parsed.filter(isSearchEntry) : [];
          render();
        } catch {
          if (status) status.textContent = 'Поиск сейчас недоступен. Обновите страницу и попробуйте снова.';
          indexRequest = undefined;
        }
      })();
      return indexRequest;
    };

    search.addEventListener('toggle', () => {
      if (!search.open) return;
      document.querySelectorAll<HTMLDetailsElement>('.mobile-menu[open]').forEach((menu) => {
        menu.open = false;
      });
      window.requestAnimationFrame(() => input?.focus());
      void loadIndex();
    });
    input?.addEventListener('input', () => {
      if (indexed) render();
      else void loadIndex();
    });
    input?.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      moveResultFocus(null, event.key === 'ArrowDown' ? 1 : -1);
    });
    search.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      search.open = false;
      search.querySelector<HTMLElement>('summary')?.focus();
    });
  });
</script>
