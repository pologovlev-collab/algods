---
import { getCollection } from 'astro:content';

import { supplementaryProblems } from '../data/supplementary-practice';
import ProblemStatus from './ProblemStatus.astro';

const lessonById = new Map((await getCollection('lessons')).map(({ data }) => [data.id, data]));
const modeLabels = {
  transfer: 'Перенос паттерна',
  independent: 'Самостоятельно',
} as const;
const difficultyLabels = { Easy: 'Легко', Medium: 'Средне' } as const;
---

<section class="supplementary-practice" aria-labelledby="supplementary-practice-title">
  <div class="supplementary-practice__intro">
    <div>
      <p class="eyebrow">Дополнительный перенос</p>
      <h2 id="supplementary-practice-title">Русскоязычная практика</h2>
    </div>
    <p>
      Шесть задач CodeRun помогают применить уже изученный паттерн в другой формулировке.
      Они не входят в счётчик LeetCode 75.
    </p>
  </div>
  <p class="verification-note">
    Названия, сложность и ссылки сверены 20 августа 2026 года с
    <a href="https://coderun.yandex.ru/catalog" target="_blank" rel="noopener noreferrer">официальным каталогом CodeRun</a>.
  </p>

  <div class="table-scroll" tabindex="0" aria-label="Таблица русскоязычных задач CodeRun">
    <table class="practice-table">
      <thead>
        <tr><th>Задача</th><th>Режим</th><th>Паттерн</th><th>Готовность</th><th>Статус</th></tr>
      </thead>
      <tbody>
        {supplementaryProblems.map((problem) => (
          <tr
            data-problem-id={`coderun:${problem.id}`}
            data-problem-prerequisites={problem.prerequisiteLessonIds.join(',')}
            data-problem-readiness="blocked"
          >
            <td>
              <a href={problem.url} target="_blank" rel="noopener noreferrer">
                <span class="problem-id">{problem.id}</span> {problem.title}
              </a>
              <small>{problem.provider} · проверено {problem.verifiedAt} · {difficultyLabels[problem.difficulty]}</small>
              <small>{problem.learningNoteRu}</small>
            </td>
            <td>{modeLabels[problem.practiceMode]}</td>
            <td>
              {problem.practiceMode === 'independent' ? (
                <details class="pattern-reveal"><summary>Показать после попытки</summary><span>{problem.primaryPattern}</span></details>
              ) : problem.primaryPattern}
            </td>
            <td>
              <small data-problem-readiness-label>Сначала завершите уроки-зависимости</small>
              <small class="problem-prerequisites">
                После: {problem.prerequisiteLessonIds.map((id, index) => {
                  const lesson = lessonById.get(id);
                  return lesson && <><a href={`/course/${lesson.slug}/`}>{lesson.title}</a>{index < problem.prerequisiteLessonIds.length - 1 ? ', ' : ''}</>;
                })}
              </small>
            </td>
            <td><ProblemStatus problemId={`coderun:${problem.id}`} title={problem.title} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
